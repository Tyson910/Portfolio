---
import { getCollection } from "astro:content";
import SnippetListView from "@components/SnippetListView.astro";
import BaseLayout from "@layouts/BaseLayout.astro";

const snippetPosts = await getCollection("snippet");
---

<BaseLayout
  title="Code Snippets"
  description="This is a hub for all snippets I've created"
>
  <main class="container mx-auto">
    <div
      class="flex flex-row justify-between items-center border-b border-accented pb-4 my-16"
    >
      <h1 class="text-3xl font-bold">Code Snippets</h1>
    </div>
    <SnippetListView snippets={snippetPosts} />
  </main>
</BaseLayout>
