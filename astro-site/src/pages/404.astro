---
import { Image } from "astro:assets";

import ScareCrow from "@assets/images/scarecrow404.svg";
import Astronaut from "@assets/images/astronaut404.svg";
import BaseLayout from "@layouts/BaseLayout.astro";

const today = new Date();
---

<BaseLayout title="Page Not Found" description="Page not found">
  <div>
    <article
      v-if="props.error?.statusCode == 404"
      class="pt-10 md:pt-5 pb-20 md:pb-36"
    >
      <div class="w-96 md:w-[32rem] lg:w-[42rem] mx-auto self-center">
        <!-- show scarecrow during October or November only -->
        <Image
          src={today.getMonth() == 9 || today.getMonth() == 10
            ? ScareCrow
            : Astronaut}
          alt=""
        />
      </div>
      <div class="flex flex-col gap-y-10">
        <h1
          class="text-4xl sm:text-5xl flex flex-col max-w-max mx-auto text-center font-medium"
        >
          This page could not be found.
        </h1>
        <a href="/" class="max-w-max mx-auto hover:underline btn btn-primary"
          >Home</a
        >
      </div>
    </article>
  </div>
</BaseLayout>
