---
import { getCollection } from "astro:content";

import BlogListView from "@components/BlogListView.astro";
import BaseLayout from "@layouts/BaseLayout.astro";

const posts = await getCollection("blog", ({ data }) => {
  return (
    data.tags.includes("TypeScript University") &&
    (import.meta.env.PROD ? data.isDraft !== true : true)
  );
});

const upcomingLessons = [
  {
    title: "Conditional Types",
    description:
      "Write types that branch based on other types using extends and infer — the foundation of most advanced utility types.",
    difficulty: "Foundational",
    lessonType: "tutorial",
  },
  {
    title: "Mapped Types",
    description:
      "Transform existing types by iterating over their keys. Build flexible type transformations without repeating yourself.",
    difficulty: "Foundational",
    lessonType: "tutorial",
  },
  {
    title: "Utility Types",
    description:
      "Master the built-in utility types — Pick, Omit, Partial, Required, ReturnType, and more — with real use cases.",
    difficulty: "Foundational",
    lessonType: "reference",
  },
  {
    title: "Zod for Runtime Validation",
    description:
      "Bridge compile-time and runtime safety with Zod. Parse external data with schemas that mirror your TypeScript types.",
    difficulty: "Advanced",
    lessonType: "tutorial",
  },
];
---

<BaseLayout
  title="TypeScript University"
  description="Master TypeScript through structured lessons and tutorials."
>
  <main class="container py-16">
    <div class="border-b border-accent pb-4">
      <h1 class="text-3xl font-bold">TypeScript University</h1>
      <p class="mt-2 max-w-2xl text-base-content/80">
        Master TypeScript through structured lessons. From foundational concepts
        to advanced patterns, build your expertise step by step.
      </p>
    </div>
    <BlogListView posts={posts} />

    <section class="mt-16">
      <div class="border-b border-accent pb-4">
        <h2 class="text-2xl font-semibold">Coming Soon</h2>
        <p class="mt-1 text-sm text-base-content/60">Lessons in progress</p>
      </div>
      <div class="grid grid-cols-1 gap-4 pt-6 opacity-70 md:grid-cols-2">
        {
          upcomingLessons.map((lesson) => (
            <article class="rounded-lg border border-base-200 bg-base-100 p-5">
              <div class="flex items-start justify-between gap-3">
                <h3 class="text-lg font-semibold text-base-content">
                  {lesson.title}
                </h3>
                <span class="shrink-0 rounded border border-base-300 px-2 py-1 text-xs text-base-content/70">
                  Coming Soon
                </span>
              </div>
              <p class="mt-3 text-sm text-base-content/70">
                {lesson.description}
              </p>
              <div class="mt-4 flex gap-2 text-xs text-base-content/60">
                <span>{lesson.difficulty}</span>
                <span>{lesson.lessonType}</span>
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>
