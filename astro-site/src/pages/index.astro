---
import { getCollection } from "astro:content";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import BaseLayout from "../layouts/BaseLayout.astro";

const snippetPosts = (await getCollection("snippet"))
  .map((post) => ({
    ...post,
    url: `/snippets/${post.id.replace(/\.[^/.]+$/, "")}`,
    displayDate: post.data.lastUpdated,
  }))
  .sort((a, b) => b.displayDate.valueOf() - a.displayDate.valueOf());
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <main class="mx-auto container px-4 py-16">
    <section>
			<div class="flex flex-row justify-between items-center border-b border-accented pb-4 mb-8">
				<h2 class="text-3xl font-bold">Code Snippets</h2>
				<a href="/snippets" class="link text-xl">View All</a>
			</div>
      <ul class="space-y-8">
        {
          snippetPosts.map((post) => (
            <li class="group border-b border-base-200 pb-8 last:border-none">
              <article>
                <h3 class="mb-2">
                  <a
                    href={post.url}
                    class="text-xl font-medium hover:text-primary"
                  >
                    {post.data.title}
                  </a>
                </h3>
                <p class="mb-3 text-base-content/80">{post.data.description}</p>
                <div class="flex items-center justify-between">
                  <div class="flex flex-wrap gap-2">
                    {post.data.tags.map((tag) => (
                      <span class="text-sm badge badge-soft badge-primary">
                        {tag}
                      </span>
                    ))}
                  </div>
                  <time
                    datetime={post.displayDate.toISOString()}
                    class="text-sm text-base-content/60"
                  >
                    {post.displayDate.toLocaleDateString("en-us", {
                      year: "numeric",
                      month: "long",
                      day: "numeric",
                    })}
                  </time>
                </div>
              </article>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</BaseLayout>
