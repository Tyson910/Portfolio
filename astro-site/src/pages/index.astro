---
import { getCollection } from "astro:content";

import BlogListView from "@components/BlogListView.astro";
import SnippetListView from "@components/SnippetListView.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { socialLinks } from "@utils/social-links";

const allBlogPosts = await getCollection("blog", ({ data }) => {
  return import.meta.env.PROD ? data.isDraft !== true : true;
});

const blogPosts = await getCollection("blog", ({ data }) => {
  return (
    data.isFeaturedPost &&
    !data.tags.includes("TypeScript University") &&
    (import.meta.env.PROD ? data.isDraft !== true : true)
  );
});

const snippetPosts = await getCollection("snippet", ({ data }) => {
  return (
    data.isFeaturedPost && (import.meta.env.PROD ? data.draft !== true : true)
  );
});

const typeScriptUniversityPosts = allBlogPosts.filter((post) =>
  post.data.tags.includes("TypeScript University")
);
---

<BaseLayout title="Homepage" description="Learn about Tyson Suttle">
  <main class="container py-16">
    <div class="pb-20">
      <div class="max-w-2xl">
        <h1
          class="text-4xl font-bold tracking-tight text-base-content sm:text-5xl"
        >
          Hi, I'm Tyson Suttle
        </h1>
        <p class="mt-6 text-base text-base-content/80">
          I'm a Full Stack Software Developer based in Phoenix, Arizona.
        </p>
        <div class="mt-6 flex gap-6">
          {
            socialLinks.map(({ ariaLabel, href, Icon }) => (
              <a class="group -m-1 p-1" href={href} aria-label={ariaLabel}>
                <Icon class="size-6 text-base-content/60 transition group-hover:text-base-content" />
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <section class="mb-16">
      <div
        class="flex flex-row justify-between items-center border-b border-accent pb-4"
      >
        <h2 class="text-3xl font-bold">TypeScript University</h2>
      </div>
      <BlogListView posts={typeScriptUniversityPosts} />
    </section>
    <section>
      <div
        class="flex flex-row justify-between items-center border-b border-accent pb-4"
      >
        <h2 class="text-3xl font-bold">Code Snippets</h2>
        <a href="/snippets" class="link text-xl">View All</a>
      </div>
      <SnippetListView snippets={snippetPosts} />
    </section>
  </main>
</BaseLayout>
