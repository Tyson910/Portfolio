---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { socialLinks } from "../utils/social-links";
import FormattedDate from "../components/FormattedDate.astro";

const snippetPosts = (await getCollection("snippet"))
  .map((post) => ({
    ...post,
    url: `/snippets/${post.id.replace(/\.[^/.]+$/, "")}`,
    displayDate: post.data.lastUpdated,
  }))
  .sort((a, b) => b.displayDate.valueOf() - a.displayDate.valueOf());
---

<BaseLayout title="Tyson Suttle" description="Learn about Tyson Suttle">
  <main class="mx-auto container px-4 py-16">
    <div class="pb-20">
      <div class="max-w-2xl">
        <h1
          class="text-4xl font-bold tracking-tight text-zinc-800 sm:text-5xl dark:text-zinc-100"
        >
          Hi, I'm Tyson Suttle
        </h1>
        <p class="mt-6 text-base text-zinc-600 dark:text-zinc-400">
          I'm a Full Stack Software Developer based in Phoenix, Arizona.
        </p>
        <div class="mt-6 flex gap-6">
          {
            socialLinks.map(({ ariaLabel, href, Icon }) => (
              <a class="group -m-1 p-1" href={href} aria-label={ariaLabel}>
                <Icon class="size-6 text-zinc-500 transition group-hover:text-zinc-600 dark:text-zinc-400 dark:group-hover:text-zinc-300" />
              </a>
            ))
          }
        </div>
      </div>
    </div>
    <section>
      <div
        class="flex flex-row justify-between items-center border-b border-accented pb-4 mb-8"
      >
        <h2 class="text-3xl font-bold">Code Snippets</h2>
        <a href="/snippets" class="link text-xl">View All</a>
      </div>
      <ul class="space-y-8">
        {
          snippetPosts.map((post) => (
            <li class="group border-b border-base-200 pb-8 last:border-none">
              <article>
                <h3 class="mb-2">
                  <a
                    href={post.url}
                    class="text-xl font-medium hover:text-primary"
                  >
                    {post.data.title}
                  </a>
                </h3>
                <p class="mb-3 text-base-content/80">{post.data.description}</p>
                <div class="flex items-center justify-between">
                  <div class="flex flex-wrap gap-2">
                    {post.data.tags.map((tag) => (
                      <span class="text-sm badge badge-soft badge-primary">
                        {tag}
                      </span>
                    ))}
                  </div>
                  <FormattedDate
                    date={post.displayDate}
                    className="text-sm text-base-content/60"
                  />
                </div>
              </article>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</BaseLayout>
