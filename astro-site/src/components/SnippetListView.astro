---
import type { CollectionEntry } from "astro:content";

import FormattedDate from "@components/FormattedDate.astro";

interface Props {
  snippets: CollectionEntry<"snippet">[];
}

const snippetPosts = Astro.props.snippets
  .map((post) => ({
    ...post,
    url: `/snippets/${post.id.replace(/\.[^/.]+$/, "")}`,
    displayDate: post.data.lastUpdated,
  }))
  .sort((a, b) => b.displayDate.valueOf() - a.displayDate.valueOf());
---

<ul class="space-y-8">
  {
    snippetPosts.map((post) => (
      <li class="group border-b border-base-200 pb-8 last:border-none">
        <article>
          <h3 class="mb-2">
            <a href={post.url} class="text-xl font-medium hover:text-primary">
              {post.data.title}
            </a>
          </h3>
          <p class="mb-3 text-base-content/80">{post.data.description}</p>
          <div class="flex items-center justify-between">
            <div class="flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <span class="badge badge-primary badge-outline badge-sm">
                  {tag}
                </span>
              ))}
            </div>
            <FormattedDate
              date={post.displayDate}
              className="text-sm text-base-content/60"
            />
          </div>
        </article>
      </li>
    ))
  }
</ul>
